# MinerU API — 文档解析
MINERU_API_KEY=your-mineru-jwt-token-here

# LLM 排版 — DeepSeek Chat（默认）
PPT_LLM_API_BASE=https://api.deepseek.com/v1
PPT_LLM_API_KEY=sk-your-deepseek-api-key-here
PPT_LLM_MODEL=deepseek-chat

# 可选：使用 Kimi 替代
# PPT_LLM_API_BASE=https://api.moonshot.cn/v1
# PPT_LLM_API_KEY=sk-your-kimi-key-here
# PPT_LLM_MODEL=kimi-k2.5
